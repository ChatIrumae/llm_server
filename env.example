# 환경 변수 예시 파일
# 실제 사용 시 .env 파일로 복사하여 사용하세요

# LangChain 서버 설정
LANGCHAIN_HOST=0.0.0.0
LANGCHAIN_PORT=80
LANGCHAIN_DEBUG=True

# Ollama 서버 설정
OLLAMA_3B_URL=http://ollama-3b:11434
OLLAMA_1B_URL=http://ollama-1b:11434
OLLAMA_TIMEOUT=30

# Chroma DB 설정
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=university_documents

# 모델 설정
DEFAULT_3B_MODEL=llama3.2:3b
DEFAULT_1B_MODEL=llama3.2:1b

# 로깅 설정
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 보안 설정
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0


# 성능 설정
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30
STREAM_CHUNK_SIZE=1024

# GPU 설정 (Docker Compose에서 사용)
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
